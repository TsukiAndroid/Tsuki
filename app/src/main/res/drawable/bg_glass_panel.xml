<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient
                android:angle="270"
                android:startColor="@color/glass_panel_gradient_start"
                android:endColor="@color/glass_panel_gradient_end"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <stroke android:width="0.8dp" android:color="@color/glass_stroke"/>
        </shape>
    </item>
</layer-list>
