<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle inner halo behind the moon -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M54,54 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z" />

    <!-- Crescent moon: outer disc minus offset disc, deep indigo (Japanese woodcut style) -->
    <path
        android:fillColor="#1B1142"
        android:pathData="M68,28
                         A26,26 0 1,0 68,80
                         A20,20 0 1,1 68,28 Z" />

    <!-- Crescent inner highlight -->
    <path
        android:fillColor="#3B2A85"
        android:pathData="M64,32
                         A22,22 0 1,0 64,76
                         A18,18 0 1,1 64,32 Z" />

    <!-- 月 character carved into the crescent (silver) -->
    <group
        android:translateX="36"
        android:translateY="38">
        <!-- Outer rectangle of 月 -->
        <path
            android:fillColor="#F2F2F5"
            android:pathData="M2,0 L18,0 L20,2 L20,32 L18,34 L2,34 L0,32 L0,2 Z" />
        <!-- Inner cut-out (transparent feel via background-tone fill) -->
        <path
            android:fillColor="#1B1142"
            android:pathData="M4,4 L16,4 L16,14 L4,14 Z" />
        <path
            android:fillColor="#1B1142"
            android:pathData="M4,18 L16,18 L16,28 L4,28 Z" />
        <!-- Bottom hook (the curve under 月) -->
        <path
            android:fillColor="#F2F2F5"
            android:pathData="M14,28 L20,28 L20,34 L18,36 Z" />
    </group>

    <!-- Tiny stars sprinkled around the moon -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,30 l1,2 l2,1 l-2,1 l-1,2 l-1,-2 l-2,-1 l2,-1 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M88,46 l1,2 l2,1 l-2,1 l-1,2 l-1,-2 l-2,-1 l2,-1 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,82 l1,1.5 l1.5,1 l-1.5,1 l-1,1.5 l-1,-1.5 l-1.5,-1 l1.5,-1 Z" />
</vector>
