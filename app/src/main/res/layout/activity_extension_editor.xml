<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Code editor — takes all remaining vertical space -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lineSpacingExtra="2dp"
                android:padding="16dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

        </androidx.core.widget.NestedScrollView>

    </HorizontalScrollView>

    <!-- Divider shown only when test console is open -->
    <View
        android:id="@+id/test_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:visibility="gone" />

    <!-- Test Console panel (hidden by default, shown via toolbar toggle) -->
    <LinearLayout
        android:id="@+id/test_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Function selector row + Run button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_function"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_list"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/ext_test_fn_list" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_details"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_test_fn_details" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pages"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_test_fn_pages" />

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_test"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/ext_test_run"
                app:icon="@drawable/ic_play" />

        </LinearLayout>

        <!-- Argument input — hint changes based on selected function -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_test_arg"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/ext_test_arg_hint_list">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_test_arg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Scrollable output area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="?attr/colorSurfaceVariant"
            android:padding="2dp">

            <TextView
                android:id="@+id/text_test_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:text="@string/ext_test_output_hint"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
