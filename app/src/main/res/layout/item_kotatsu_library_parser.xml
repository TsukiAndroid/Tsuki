<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Language tag badge -->
    <TextView
        android:id="@+id/text_lib_parser_lang"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_lang_badge"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="10sp" />

    <!-- Name + domain + status column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_lib_parser_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/text_lib_parser_domain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Status row: shown only when parser is already added as a source -->
        <LinearLayout
            android:id="@+id/layout_added_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:visibility="gone">

            <View
                android:id="@+id/dot_status"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_lang_badge"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/text_added_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action button — text and style change based on added/manage state -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lib_add"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:text="@string/add_source_label" />

</LinearLayout>
