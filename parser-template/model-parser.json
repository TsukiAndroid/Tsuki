{
  "name": "My Site Name",
  "version": "1.0",
  "type": "html",

  "domains": ["example.com", "mirror.example.com"],

  "fingerprints": ["my-unique-css-class", "my-site-specific-string"],

  "endpointProbes": [
    { "path": "/api/comics",    "contains": "\"slug\""     },
    { "path": "/api/v1/series", "contains": "\"chapters\"" }
  ],

  "mangaList": {
    "method": "GET",
    "endpoint": "/manga",
    "pageParam": "page",
    "pagination": "page",
    "itemSelector": "div.page-item-detail",
    "titleSelector": ".post-title a",
    "coverSelector": "img.img-responsive",
    "linkSelector": ".post-title a",
    "searchEndpoint": "/",
    "searchParam": "s"
  },

  "mangaDetail": {
    "titleSelector": "div.post-title h1",
    "coverSelector": "div.summary_image img",
    "descriptionSelector": "div.summary__content"
  },

  "chapterList": {
    "selector": "li.wp-manga-chapter",
    "titleSelector": "a",
    "linkSelector": "a",
    "action": "manga_get_chapters",
    "endpoint": "/wp-admin/admin-ajax.php"
  },

  "pageList": {
    "imageSelector": "div.reading-content img"
  },

  "genres": {
    "endpoint": "/genre",
    "selector": "li.cat-item"
  }
}
