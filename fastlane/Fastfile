# Tsuki Android build lanes
#
# These lanes build the product flavors defined by the project.
# IzzyOnDroid should use the stable flavor for the main listing.

default_platform(:android)

platform :android do
  desc "Build the stable release APK"
  lane :stable do
    gradle(task: "assembleStableRelease")
  end

  desc "Build the beta release APK"
  lane :beta do
    gradle(task: "assembleBetaRelease")
  end

  desc "Build the alpha release APK"
  lane :alpha do
    gradle(task: "assembleAlphaRelease")
  end

  desc "Run the Android test suite"
  lane :test do
    gradle(task: "test")
  end
end
